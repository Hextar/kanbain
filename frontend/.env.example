# Flask origin for `npm run dev` (Server Components + /api proxy).
API_URL=http://localhost:3000

# Browser WebSocket (API port). Set to `off` to disable (`npm run dev:mock` does this).
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Set to 1 only when Next sits behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Otherwise the API proxy ignores client-supplied forwarded IPs
# so rate limits cannot be spoofed.
# TRUST_PROXY=1
