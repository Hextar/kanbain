# Optional. Vite loads this automatically; `npm run dev:prod` forces false.
# true  (default) — MSW mocks in `npm run dev`
# false — real Flask API
#
# If you previously ran `npm run dev`, a leftover mock service worker can
# keep intercepting `/api` until the page reloads once with mocks off.
VITE_ENABLE_MOCKS=true
